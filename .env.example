# Copy this file to .env and fill in the values.
#   cp .env.example .env

# --- Atlas -------------------------------------------------------------------
# `python -m sql_demo setup` installs the Atlas CLI if needed and starts
# `atlas auth login`. The account needs Project Owner on this project.
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_NAME=

# Database the SQL Interface should expose. It must already contain data.
# Comma-separate database names to expose more than one.
ATLAS_DATABASE=sample_mflix

# Atlas database user for the schema builder and Power BI.
SQL_USERNAME=sql-demo
# Leave blank to generate a password and reuse it from output/.
SQL_PASSWORD=

# Local Windows account on the VM. Do not use admin, administrator, guest, or root.
# The password must be 12-123 characters and include three of:
# lowercase, uppercase, digit, symbol. Leave it blank to generate one.
VM_ADMIN_USERNAME=sqlInterfaceDemo
VM_ADMIN_PASSWORD=

# Azure region for the VM. Azure uses the active subscription from `az login`.
AZURE_LOCATION=eastus
